# Which network the app talks to: studionet | bradbury
NEXT_PUBLIC_NETWORK=bradbury

# The deployed Sentinel contract on that network.
NEXT_PUBLIC_CONTRACT_ADDRESS=0x

# Server-side only. The patrol bot signs `challenge_agent` with this key, so it
# is the wallet that stakes on every challenge Sentinel files. It must hold GEN.
# NEVER prefix this with NEXT_PUBLIC_ — that would ship it to the browser.
PATROL_PRIVATE_KEY=

# Optional shared secret. When set, /api/patrol requires
# `Authorization: Bearer <this>` unless the caller is Vercel Cron.
PATROL_SECRET=
